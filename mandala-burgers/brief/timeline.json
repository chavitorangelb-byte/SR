    {
      "f": 114,
      "que": "La cinta empieza a dibujar el marco del celular (SDF línea → rectángulo redondeado)"
    },
    {
      "f": 144,
      "que": "Celular entra en perspectiva 18° y se endereza (f144–f204)"
    },
    {
      "f": 186,
      "que": "Se enciende el encabezado con el logo"
    },
    {
      "f": 204,
      "que": "Héroe: titular, subtítulo y botón mostaza, en cascada (f204–f252)"
    },
    {
      "f": 288,
      "que": "La cinta se abre en pétalos de mandala (SDF aro → 5 pétalos); cada pétalo cae como punto de color"
    },
    {
      "f": 360,
      "que": "Tap en un color. Filtro. Tarjetas entran con inclinación 10° y destello: Point f366, Moksha f384, Purusha f438, Mandala f456"
    },
    {
      "f": 504,
      "que": "Scroll con whoosh a Hotdogs y Entradas: Point Dog $49, Frenchies $79"
    },
    {
      "f": 576,
      "que": "Scroll a Postres. Fogata ilustrada, bombones que se doran, chispas lentas"
    },
    {
      "f": 720,
      "que": "Groove vuelve. La cinta sale de la fogata hacia la esquina"
    },
    {
      "f": 744,
      "que": "La cinta se vuelve el botón flotante de WhatsApp (SDF cinta → círculo)"
    },
    {
      "f": 768,
      "que": "Tap en el botón. Burbuja de chat: 'Hola, quiero hacer un pedido' (f780–f840)"
    },
    {
      "f": 864,
      "que": "Tarjeta de reseñas: frase 1 f870, frase 2 f906, frase 3 f942"
    },
    {
      "f": 1008,
      "que": "La cinta traza las calles del mapa (f1008–f1068) y cae el pin f1074"
    },
    {
      "f": 1080,
      "que": "Tarjeta de cristal con horario y dirección; chips 'Pet friendly' y 'Tarjetas' f1104, f1116"
    },
    {
      "f": 1152,
      "que": "Lift. El celular se desliza a la izquierda y entra el marco de navegador con el menú a 3 columnas (f1152–f1236)"
    },
    {
      "f": 1296,
      "que": "Las dos pantallas se alejan; la cinta se enrosca en aro (SDF) y revela el logo por máscara circular (f1296–f1356)"
    },
    {
      "f": 1404,
      "que": "Todo se detiene. Música a sub grave con filtro cerrado"
    },
    {
      "f": 1440,
      "que": "End card: panel de cristal oscuro, logo, línea, Instagram, botón de WhatsApp, pie legal"
    },
    {
      "f": 1620,
      "que": "Campanada suave con sub grave en el corte final"
    }
